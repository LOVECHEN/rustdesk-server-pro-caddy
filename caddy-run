#!/command/with-contenv sh
# Caddy 反代：HTTPS :21120 → hbbs 的 :21114（Web 控制台）。s6 监管。listen 一律 bind 全网卡。
# 证书自动决策（优先级）：
#   1) CADDY_DOMAIN=域名/公网IP  → 该名字走 ACME(Let's Encrypt) 真证书，签不下来回落内部自签
#   2) 网卡本身就有公网 IP        → 该公网 IP 走 ACME（回落自签）
#   3) 其余（纯内网 / NAT / 代理后）→ 内网 IP 自签(内部 CA)，直接可用
# ★ 默认【不】主动探测"对外出口 IP"：代理 / NAT / 防火墙后探到的是【出口地址】、并非本容器能被回连的地址，
#   拿它申证书必失败、还把错的 IP 写进 SAN。真有 NAT 公网(如 Oracle)且确认 80/443 能回连本机，才 CADDY_PROBE=1 开探测。
# 手动：CADDY_DOMAIN 指名字/公网IP 走 ACME（要公网证书就把它设成你的真域名或真公网IP）；
#       CADDY_ACME=0 强制只自签；CADDY_PROBE=1 开启对外 IP 探测(仅限确认可回连的 NAT 公网机，慎用)。
mkdir -p /etc/caddy /data/caddy

# 网卡 IPv4：分私网段 / 公网段
_all4=$(ip -4 -o addr 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | grep -vE '^127\.')
lan_ips=$(printf '%s\n' $_all4 | grep -E '^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|169\.254\.)')
nic_pub=$(printf '%s\n' $_all4 | grep -vE '^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|169\.254\.)')

# 对外公网 IP：默认不探（代理/NAT 后探到的是出口 IP、非本容器可回连地址）。仅 CADDY_PROBE=1 时才探。
ext_pub=""
if [ "${CADDY_PROBE:-0}" = "1" ] && [ -z "$nic_pub" ]; then
  for u in http://checkip.amazonaws.com http://api.ipify.org http://ifconfig.me/ip; do
    ext_pub=$(wget -qO- -T 4 "$u" 2>/dev/null | tr -d ' \r\n' | grep -oE '^[0-9.]+$')
    [ -n "$ext_pub" ] && break
  done
fi
pub_ip=$(printf '%s\n%s\n' "$nic_pub" "$ext_pub" | grep -E '^[0-9.]+$' | head -1)

# 按优先级定 地址集(空格分隔) 与 签发器块
if [ -n "${CADDY_DOMAIN:-}" ]; then
  ADDRS="${CADDY_DOMAIN}"
  TLSBLK=$([ "${CADDY_ACME:-1}" = "0" ] && printf '\ttls internal' || printf '\ttls {\n\t\tissuer acme\n\t\tissuer internal\n\t}')
elif [ -n "$pub_ip" ] && [ "${CADDY_ACME:-1}" != "0" ]; then
  ADDRS="$pub_ip"                                             # 公网 IP → ACME 真证书(回落自签)
  TLSBLK=$(printf '\ttls {\n\t\tissuer acme\n\t\tissuer internal\n\t}')
else
  ADDRS=$(printf '%s\n127.0.0.1\nlocalhost\n' $lan_ips | grep . | awk '!seen[$0]++' | paste -sd' ' -)  # 内网IP+127.0.0.1+localhost
  [ -z "$ADDRS" ] && ADDRS=localhost
  TLSBLK=$(printf '\ttls internal')                           # 纯内网 → 自签
fi

# ★ 每个地址都带 :21120（否则 :21120 只贴最后一个）；DEFSNI=第一个名字(无 SNI 的 IP 访问用它)
SITE=$(printf '%s\n' $ADDRS | sed 's/$/:21120/' | paste -sd' ' -)
DEFSNI=$(printf '%s\n' $ADDRS | head -1)

{
  printf '{\n\tadmin off\n\tstorage file_system /data/caddy\n\tdefault_sni %s\n}\n' "$DEFSNI"
  printf '%s {\n' "$SITE"
  printf '\tbind 0.0.0.0 [::]\n'
  printf '%s\n' "$TLSBLK"
  printf '\treverse_proxy 127.0.0.1:21114\n}\n'
} > /etc/caddy/Caddyfile

echo "[caddy-run] site=${SITE}  default_sni=${DEFSNI}" >&2
exec caddy run --config /etc/caddy/Caddyfile
